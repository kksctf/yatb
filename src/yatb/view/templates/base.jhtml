<!DOCTYPE html>
<html lang="{{ request.state.lang }}">

<head>
    <meta charset="utf-8">
    <title>
        {% block title %}{{ CTF_NAME }}{% endblock %}
    </title>
    <script>
        // Set initial theme ASAP to reduce flash
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.dataset.theme = saved || (sysDark ? 'dark' : 'light');
            } catch (_) { /* no-op */ }
        })();
    </script>
    <link rel="stylesheet" href="{{ url_for('static', path='layout.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='style.css') }}">
    <!-- Bulma & HTMX from CDNs -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.1/css/bulma.min.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="icon" type="image/png" href="{{ url_for('static', path='kksctf_logo_32.png') }}" />
    {# optional per-page extra tags #}
    {% block extra_head %}{% endblock %}
</head>

<body>
    <nav class="navbar" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item" href="{{ url_for('index') }}">
                <figure class="image is-24x24">
                    <img src="{{ url_for('static', path='logo.png') }}" />
                </figure>
                {{ CTF_NAME }}
            </a>

            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="yatbNavbar">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>
        <div id="yatbNavbar" class="navbar-menu">
            <div class="navbar-start">
                <a class="navbar-item" href="{{ url_for('tasks_page') }}">{{ _("Challenges") }}</a>
                <a class="navbar-item" href="{{ url_for('scoreboard_page') }}">{{ _("Scoreboard") }}</a>
            </div>
            <div class="navbar-end">
                {% if curr_user %}
                <form id="flag-submit-form" class="navbar-item" method="post" action="{{ url_for('api_task_submit_flag') }}"
                    hx-post="{{ url_for('api_task_submit_flag') }}" hx-swap="none">
                    <div class="field has-addons">
                        <p class="control">
                            <span class="button is-static">{{ FLAG_BASE }}{</span>
                        </p>
                        <p class="control is-expanded">
                            <input id="flag-submit-input" class="input" name="flag" placeholder="sampl3_fl4g" required>
                        </p>
                        <p class="control">
                            <span class="button is-static">}</span>
                        </p>
                        <p class="control">
                            <button class="button is-info">{{ _("Submit") }}</button>
                        </p>
                    </div>
                </form>
                <a class="navbar-item" href="{{ url_for('profile_page') }}">{{ curr_user.display_name }}</a>
                {% if curr_user.is_admin %}
                <a class="navbar-item" href="{{ url_for('admin_ng_html_landing', path='') }}">{{ _("Admin area") }}</a>
                <!-- before_start = {{ EVENT_START_TIME - NOW() }}, before_end = {{ EVENT_END_TIME - NOW() }} -->
                {% endif %}
                <a class="navbar-item" href="{{ url_for('api_users_logout') }}">
                    {{ _("Logout") }}
                </a>
                {% else %}
                <a class="navbar-item" href="{{ url_for('login_page') }}">{{ _("Login") }}</a>
                {% endif %}
                <div class="navbar-item has-dropdown is-hoverable">
                    <a class="navbar-link">
                        <span class="icon"><i class="fa-solid fa-language"></i></span>
                        <span>{{ request.state.lang | upper }}</span>
                    </a>
                    <div class="navbar-dropdown is-right">
                        <a class="navbar-item {% if request.state.lang == 'en' %}is-active{% endif %}"
                            href="{{ request.url.replace_query_params(lang='en') }}">English</a>
                        <a class="navbar-item {% if request.state.lang == 'ru' %}is-active{% endif %}"
                            href="{{ request.url.replace_query_params(lang='ru') }}">Русский</a>
                    </div>
                </div>
                <div class="navbar-item">
                    <button id="theme-toggle" class="button is-light" title="{{ _('Toggle theme') }}" aria-label="{{ _('Toggle theme') }}">
                        <span class="icon"><i class="fa-solid fa-moon"></i></span>
                    </button>
                </div>
            </div>
        </div>
    </nav>
    <section class="section">
        {% block content %}{% endblock %}
    </section>

    {% if curr_user %}
    <script>
        (function () {
            const form = document.getElementById("flag-submit-form");
            if (!form) return;

            let toastStack = null;

            function ensureToastStack() {
                if (toastStack) return toastStack;
                toastStack = document.createElement("div");
                toastStack.className = "app-toast-stack";
                toastStack.setAttribute("aria-live", "polite");
                toastStack.setAttribute("aria-atomic", "true");
                document.body.appendChild(toastStack);
                return toastStack;
            }

            function parsePayload(xhr) {
                const text = (xhr && xhr.responseText) || "";
                if (!text) return null;
                try {
                    return JSON.parse(text);
                } catch (_) {
                    return text;
                }
            }

            function readMessage(xhr, isSuccess) {
                const payload = parsePayload(xhr);
                if (payload && typeof payload === "object" && payload.detail) return String(payload.detail);
                if (typeof payload === "string" && payload.trim()) {
                    return isSuccess ? "Flag accepted" : payload;
                }
                if (typeof payload === "number" || typeof payload === "boolean") return String(payload);
                return isSuccess ? "Flag accepted" : "Flag rejected";
            }

            function extractTaskId(xhr) {
                const payload = parsePayload(xhr);
                if (typeof payload === "string" && payload.trim()) return payload.trim();
                if (payload && typeof payload === "object" && typeof payload.task_id === "string") return payload.task_id.trim();
                return "";
            }

            function markTaskSolved(taskId) {
                if (!taskId) return;
                document.querySelectorAll('[data-task-id="' + taskId + '"]').forEach(function (card) {
                    card.classList.add("solved");
                    const header = card.querySelector(".card-header");
                    if (header) header.classList.add("has-background-success");
                    const pointsTag = card.querySelector(".task-card-tags .tag");
                    if (pointsTag) pointsTag.classList.add("is-success");
                });
            }

            function showFlagToast(isSuccess, message) {
                const stack = ensureToastStack();
                const toast = document.createElement("div");
                toast.className = "notification app-toast " + (isSuccess ? "is-success" : "is-danger");
                toast.setAttribute("role", "status");

                const content = document.createElement("div");
                content.className = "app-toast-message";
                content.textContent = message;

                const closeButton = document.createElement("button");
                closeButton.className = "delete";
                closeButton.type = "button";
                closeButton.setAttribute("aria-label", "Close");

                toast.appendChild(closeButton);
                toast.appendChild(content);
                stack.appendChild(toast);

                let hideTimer = null;
                let endAt = Date.now() + 4500;

                function closeToast() {
                    if (!toast.isConnected) return;
                    toast.classList.remove("is-visible");
                    toast.classList.add("is-leaving");
                    setTimeout(function () {
                        if (toast.isConnected) toast.remove();
                    }, 180);
                }

                function scheduleHide(delay) {
                    if (hideTimer) clearTimeout(hideTimer);
                    hideTimer = setTimeout(closeToast, Math.max(0, delay));
                }

                requestAnimationFrame(function () {
                    toast.classList.add("is-visible");
                });

                scheduleHide(4500);

                toast.addEventListener("mouseenter", function () {
                    if (hideTimer) clearTimeout(hideTimer);
                });
                toast.addEventListener("mouseleave", function () {
                    scheduleHide(endAt - Date.now());
                });
                closeButton.addEventListener("click", closeToast);
            }

            document.body.addEventListener("htmx:afterRequest", function (event) {
                if (event.target !== form || !event.detail || !event.detail.xhr) return;

                const xhr = event.detail.xhr;
                const isSuccess = xhr.status === 200;
                const message = readMessage(xhr, isSuccess);

                showFlagToast(isSuccess, message);

                if (isSuccess) {
                    const input = document.getElementById("flag-submit-input");
                    if (input) input.value = "";
                    markTaskSolved(extractTaskId(xhr));
                }
            });
        })();

        // const evt = new EventSource("/events");
        /* evt.addEventListener("toast", (e) => {
            const msg = JSON.parse(e.data);
            bulmaToast.toast({
                message: msg.text,
                type: msg.kind === "hint" ? "is-info" : "is-success",
                position: "top-center",
                dismissible: true,
                duration: 5000,
            });
        }); */
    </script>
    {% endif %}
    <script>
        (function () {
            function applyIcon(theme) {
                var btn = document.getElementById('theme-toggle');
                if (!btn) return;
                btn.classList.remove('is-light', 'is-dark');
                btn.classList.add(theme === 'dark' ? 'is-dark' : 'is-light');
                var icon = btn.querySelector('i');
                if (icon) icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }

            document.addEventListener('DOMContentLoaded', function () {
                var root = document.documentElement;
                applyIcon(root.dataset.theme === 'dark' ? 'dark' : 'light');
                var btn = document.getElementById('theme-toggle');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var current = root.dataset.theme === 'dark' ? 'dark' : 'light';
                    var next = current === 'dark' ? 'light' : 'dark';
                    root.dataset.theme = next;
                    try { localStorage.setItem('theme', next); } catch (_) { /* ignore */ }
                    applyIcon(next);
                });

                var burger = document.querySelector('.navbar-burger');
                var menu = document.getElementById(burger.dataset.target);

                burger.addEventListener('click', function () {
                    burger.classList.toggle('is-active');
                    menu.classList.toggle('is-active');
                });
            });
        })();
    </script>

{% block footer %}
<footer class="footer" role="contentinfo" aria-label="Site footer">
  <div class="container">
    <nav class="level is-mobile" aria-label="Footer navigation">
      <div class="level-left">
        <div class="level-item">
          <span class="is-size-7 has-text-grey">&copy; 2026 kksctf</span>
        </div>
      </div>

      <div class="level-item has-text-centered">
        <span class="is-size-7">{{ version_string() }}</span>
      </div>

      <div class="level-right">
        <div class="level-item">
          <a href="https://github.com/kksctf/yatb" class="is-size-7" target="_blank" rel="noopener" aria-label="Open project on GitHub">
            <span class="icon is-small" aria-hidden="true" style="vertical-align:-2px;">
              <i class="fa-brands fa-github"></i>
            </span>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </nav>
  </div>
</footer>
{% endblock %}
</body>

</html>
