{% extends "base.jhtml" %}

{% block title %} {{ _("Login") }} {% endblock title %}

{% block content %}
<div class="container">
  <section class="section">
    <div class="container is-max-desktop has-text-centered">
      <h1 class="title is-3">{{ _("Please log in or register") }}</h1>

      {# ───────────────  available auth methods  ──────────────── #}
      {% if len(auth_ways) == 1 %}
          <div class="mt-3">
              {{ auth_ways[0].generate_html(request.url_for) | safe }}
          </div>
          
          <script>
              {{ auth_ways[0].generate_script(request.url_for) | safe }}
          </script>
      {% else %}
          {% for auth_way in auth_ways %}
              {% set aw_type = auth_way.__name__ %}

              <details class="box my-4" id="auth-{{ aw_type }}-box">
                  <summary class="has-text-weight-semibold">
                  {{ _("Auth using:") }} {{ aw_type }}
                  </summary>

                  <div class="mt-3">
                  {{ auth_way.generate_html(request.url_for) | safe }}
                  </div>
                  
                  <script>
                      {{ auth_way.generate_script(request.url_for) | safe }}
                  </script>
              </details>
          {% endfor %}
      {% endif %}
    </div>
  </section>
</div>
{% endblock content %}
