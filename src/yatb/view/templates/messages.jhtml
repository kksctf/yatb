{% extends "base.jhtml" %}
{% block title %}{{ _("Messages") }}{% endblock %}
{% block content %}
<h1 class="title is-3">{{ _("Recent messages") }}</h1>
<ul>
  {% for m in msgs %}
    <li>{{ m.ts[:19] }} – {{ m.text }}</li>
  {% else %}
    <p>{{ _("No messages yet.") }}</p>
  {% endfor %}
</ul>
{% endblock %}