{#
  Also update the header order when the body refreshes.
  This <tr> will be swapped out-of-band into #scoreboard-head by htmx.
 #}
<tr id="scoreboard-head" class="sb-tasks-head" hx-swap-oob="innerHTML:#scoreboard-head">
  <th>{{ _("Position", request) }}</th>
  <th>{{ _("User", request) }}</th>
  <th>{{ _("Score", request) }}</th>
  {%- for header in task_headers -%}
  <th class="sb-rot-th">
    <a class="sb-rot" href="{{ header.url }}"><span>{{ header.label }}</span></a>
  </th>
  {%- endfor -%}
</tr>

{%- for row in scoreboard_rows -%}
  <tr>
    <th>{{ row.position }}</th>
    <td>{{ row.username }}</td>
    <td>{{ row.score }}</td>

    {%- for cell in row.cells -%}
    <td class="p-0">
      <div class="is-justify-content-center">
        <a href="{{ cell.url }}" class="sb-link">
          <div class="{{ cell.classes }}" title="{{ cell.tooltip }}">
            <i class="{{ cell.icon_class }}"></i>
            {%- if cell.solved -%}
              <span class="visually-hidden">+</span>
            {%- endif -%}
            {%- if cell.extra_icon_class -%}
              <i class="{{ cell.extra_icon_class }}"></i>
            {%- endif -%}
          </div>
        </a>
      </div>
    </td>
    {%- endfor -%}
  </tr>
{%- endfor -%}
