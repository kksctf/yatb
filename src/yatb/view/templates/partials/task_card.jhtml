{# `oob` is set only by the htmx twin in view/actions.py; htmx matches the swap target by
   `id`, which is why the card carries both that and the `data-task-id` filters use. #}
<div id="task-{{ task.task_id }}" class="card {% if task.is_solved_by(curr_user) %}solved{% endif %} {% if task.hidden %}task-hidden{% endif %}" data-task-id="{{ task.task_id }}" {% if oob %}hx-swap-oob="true"{% endif %}>
  <header class="card-header {% if task.is_solved_by(curr_user) %}has-background-success{% endif %}">
    <a href="{{ url_for('one_task_page', task_id=task.task_id) }}" class="card-header-title">
      <div class="media">
        <div class="media-content">
          <p class="title is-6">{% if task.hidden %}<i class="fa-solid fa-eye-slash" title="{{ _('Task is hidden') }}"></i> {% endif %}{{ task.task_name }}</p>
          <p class="subtitle mt-1 is-7">{{ task.category|capitalize }}</p>
        </div>
      </div>
    </a>
    <div class="task-card-tags p-0">
      <div class="tags has-addons">
        <span class="tag {% if task.is_solved_by(curr_user) %}is-success{% endif %}"><i class="fa-solid fa-award"></i>{{ task.scoring.points }}</span>
        <span class="tag is-dark"><i class="fa-solid fa-check-double"></i>{{ task.solves }}</span>
      </div>
    </div>
  </header>

  <div class="card-content">
    <div class="content"> 
      {{ task.description_html | safe }}
    </div>

    {% if curr_user and curr_user.is_admin %}
    {% include "partials/task_debug.jhtml" %}
    {% endif %}

    {% if curr_user and task.dti %}
    <hr class="mt-3 mb-2">
    <div id="data-{{ task.task_id }}" class="dynamic_task_info_field content is-small" data-id="{{ task.task_id }}" {# hx-get="{{ url_for('dynamic_task_info', task_id=task.task_id) }}" #} hx-trigger="load, revealed"
      hx-target="#data-{{ task.task_id }}" hx-swap="innerHTML">
      {{ _("No info ;(") }}
    </div>

    <form class="mt-2" method="get" hx-target="#data-{{ task.task_id }}" hx-swap="innerHTML">
      {# Up to six buttons in a card that can be 260px wide, so they have to wrap. #}
      <div class="buttons are-small has-addons is-centered is-flex-wrap-wrap">
        <input type="hidden" name="task_id" value="{{ task.task_id }}">

        <button type="submit" class="button dynamic_task_start"
          formaction="{{ url_for('api_dynamic_task_start', task_id=task.task_id) }}"
          hx-get="{{ url_for('api_dynamic_task_start', task_id=task.task_id) }}">{{ _("Start") }}</button>

        <button type="submit" class="button dynamic_task_restart"
          formaction="{{ url_for('api_dynamic_task_restart', task_id=task.task_id) }}"
          hx-get="{{ url_for('api_dynamic_task_restart', task_id=task.task_id) }}">{{ _("Restart") }}</button>

        <button type="submit" class="button dynamic_task_stop"
          formaction="{{ url_for('api_dynamic_task_stop', task_id=task.task_id) }}"
          hx-get="{{ url_for('api_dynamic_task_stop', task_id=task.task_id) }}">{{ _("Stop") }}</button>

        <button type="submit" class="button dynamic_task_extend"
          formaction="{{ url_for('api_dynamic_task_extend', task_id=task.task_id) }}"
          hx-get="{{ url_for('api_dynamic_task_extend', task_id=task.task_id) }}">{{ _("Extend") }}</button>

        <button type="submit" class="button dynamic_task_info"
          formaction="{{ url_for('api_dynamic_task_info', task_id=task.task_id) }}"
          hx-get="{{ url_for('api_dynamic_task_info', task_id=task.task_id) }}">{{ _("Info") }}</button>

        {% if curr_user.is_admin %}
        <button type="submit" class="button dynamic_task_start_rebuild"
          formaction="{{ url_for('api_dynamic_task_start', task_id=task.task_id) }}?force_rebuild=1"
          hx-get="{{ url_for('api_dynamic_task_start', task_id=task.task_id) }}?force_rebuild=1">{{ _("Start with rebuild") }}</button>
        {% endif %}
      </div>
    </form>

    {% endif %}
  </div>

  <footer class="card-footer">
    {% if task.first_pwned_str() %}
    {% set first_user, first_time = task.first_pwned_str() %}
    <span class="card-footer-item is-size-7 is-flex is-flex-direction-column is-align-items-center"
      style="word-break: break-all;">
      🥇 <span>{{ uid2name.get(first_user, '??') }}</span>
      <small>{{ first_time }}</small>
    </span>
    {% endif %}

    {% if task.last_pwned_str() %}
    {% set last_user, last_time = task.last_pwned_str() %}
    <span class="card-footer-item is-size-7 is-flex is-flex-direction-column is-align-items-center"
      style="word-break: break-all;">
      💥 <span>{{ uid2name.get(last_user, '??') }}</span>
      <small>{{ last_time }}</small>
    </span>
    {% endif %}
  </footer>
</div>
