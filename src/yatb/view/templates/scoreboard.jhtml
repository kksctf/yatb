{% extends "base.jhtml" %}

{% block title %}{{ _("Scoreboard", request) }}{% endblock %}

{% block extra_head %}
  <!-- Font-Awesome for check / x / star icons -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    :root { --sb-cell: 2.5rem; }
    /* indicator box 20×20, centred glyph */
    .sb-indicator {
      width: var(--sb-cell); height: var(--sb-cell);
      display:flex; align-items:center; justify-content:center;
      font-size:0.75rem;
      line-height:1;                       /* tighter vertical align   */
      position:relative;
    }
    .sb-solved        { background:var(--bulma-success); color: #222;}  /* normal solve  */
    .sb-solved-last   { background:var(--bulma-success); color: #222;}  /* user’s last   */
    .sb-solved-first  { background:var(--bulma-success); color: #222;}  /* first blood   */
    .sb-unsolved      { color:#555; }

    .sb-last-dot {
      position:absolute; top:3px; right:3px;
      font-size:.75rem; color:blue;
      z-index: 99999;
    }

    .sb-star {
      position:absolute; top:3px; right:3px;
      font-size:.75rem; color:#dc2626;
      z-index: 99999;
      -webkit-text-stroke-width: 1px;
      -webkit-text-stroke-color: black;
    }

    /* rotated task header labels */
    .sb-tasks-head {  }
    .sb-rot-th {
      width: var(--sb-cell);
      min-width: var(--sb-cell);
      max-width: var(--sb-cell);
      position: relative;
      overflow: visible;
    }
    .sb-rot {
      position: absolute;
      left: calc(var(--sb-cell) / 2);
      transform: rotate(-30deg);
      transform-origin: bottom left;
      white-space: nowrap;
      text-align: left;
    }
    .sb-rot:link, .sb-rot:visited, .sb-rot:hover, .sb-rot:focus, .sb-rot:active { 
      color: inherit;
      text-decoration: none;
    }
    .sb-rot span { font-size:.8rem; }
    /* make indicator columns exactly the square width */
    #scoreboard-table td:has(> .sb-indicator) { padding: 0; }
  </style>
{% endblock %}

{% block content %}
<div class="container is-fluid">
  <h1 class="title is-3">{{ _("Scoreboard", request) }}</h1>

  <table id="scoreboard-table" class="table is-fullwidth">
    <thead>
      <tr id="scoreboard-head" class="sb-tasks-head">
      {# to be filled by partial scoreboard load #}
      </tr>
    </thead>

    <tbody id="scoreboard-body"
          hx-get="{{ url_for('scoreboard_page') }}"
          hx-trigger="load, every 30s"
          hx-target="#scoreboard-body"
          hx-swap="innerHTML">
      {% include "partials/scoreboard_table.jhtml" %}
    </tbody>
  </table>
</div>
{% endblock %}
