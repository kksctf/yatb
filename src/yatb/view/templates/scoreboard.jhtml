{% extends "base.jhtml" %}

{% block title %}Scoreboard{% endblock %}

{% block extra_head %}
  <!-- Font-Awesome for check / x / star icons -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    /* indicator box 20×20, centred glyph */
    .sb-indicator {
      width: 2.5rem; height: 2.5rem;
      display:flex; align-items:center; justify-content:center;
      font-size:0.75rem;
      line-height:1;                       /* tighter vertical align   */
    }
    .sb-solved        { background:var(--bulma-success); color: #222;}  /* normal solve  */
    .sb-solved-last   { background:var(--bulma-primary); color: #222;}  /* user’s last   */
    .sb-solved-first  { background:var(--bulma-info); color: #222;}  /* first blood   */
    .sb-unsolved      { color:#555; }          /* simple “x”    */

    /* tiny red dot for “just solved” */
    .sb-last-dot {
      position:absolute; top:-2px; right:-2px;
      width:.5rem; height:.5rem; border-radius:50%;
      background:#dc2626; border:1px solid #222;
      z-index: 99999;
    }

    .sb-star {
      position:absolute; top:-4px; right:-6px;
      font-size:.55rem; color:#ffc107;
      z-index: 99999;
    }
  </style>
{% endblock %}

{% block content %}
<h1 class="title is-3">Scoreboard</h1>

<table class="table is-fullwidth">
  <thead>
    <tr>
      <th></th>
      <th>who</th>
      <th>how much</th>
      <th></th>
    </tr>
  </thead>

  <tbody id="scoreboard-body"
         hx-get="{{ url_for('scoreboard_page') }}"
         hx-trigger="load, every 30s"
         hx-target="#scoreboard-body"
         hx-swap="innerHTML">
    {% include "partials/scoreboard_table.jhtml" %}
  </tbody>
</table>
{% endblock %}
