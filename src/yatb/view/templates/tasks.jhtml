{% extends "base.jhtml" %}

{% block title %}{{ _("Challenges", request) }}{% endblock %}
{% block extra_head %}{% endblock %}

{% block content %}
<h1 class="title is-3">{{ _("Challenges", request) }}</h1>

<!-- ── filters (trigger HTMX GETs) ───────────────────────────── -->
<div class="mb-4">
    <label class="checkbox mr-3">
        <input type="checkbox" name="show_solved" hx-get="{{ url_for('tasks_page') }}" hx-target="#tasks-container"
            hx-include="closest .section" checked>
        Show solved
    </label>

    {% for cat in ['crypto', 'binary', 'web', 'forensic', 'other'] %}  {# TODO: dynamic category retrieval #}
    <label class="checkbox mr-2">
        <input type="checkbox" name="category" value="{{ cat }}" hx-get="{{ url_for('tasks_page') }}"
            hx-target="#tasks-container" hx-include="closest .section" checked>
        {{ cat|capitalize }}
    </label>
    {% endfor %}
</div>

<!-- first paint or non-JS browsers get the full list -->
{% include "partials/task_container.jhtml" %}
{% endblock %}
