<div class="column is-one-quarter {% if task.solved_by(curr_user) %}solved{% endif %}">
    <div class="card">
        <header class="card-header {% if task.solved_by(curr_user) %}has-background-success{% endif %}">
            <p class="card-header-title is-size-6">{{ task.task_name }}</p>
            <span class="tag is-light">{{ task.scoring.points }}</span>
        </header>

        <div class="card-content">
            {{ task.description_html | safe }}
        </div>

        <footer class="card-footer">
            <a href="/tasks/{{ task.task_id }}" class="card-footer-item is-size-7">Open</a>
        </footer>
    </div>
</div>