{% extends "base.jhtml" %}

{% block title %}Scoreboard{% endblock %}

{% block extra_head %}
  <!-- Font-Awesome for check / x / star icons -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    /* indicator box 20×20, centred glyph */
    .sb-indicator {
      width: 1.25rem; height: 1.25rem;
      display:flex; align-items:center; justify-content:center;
      margin:1px 2px; font-size:0.75rem;
      line-height:1;                       /* tighter vertical align   */
      border-radius: 2px;                  /* slight rounding          */
    }
    .sb-solved        { background:#99d98c; }  /* normal solve  */
    .sb-solved-last   { background:#d9ed92; }  /* user’s last   */
    .sb-solved-first  { background:#92d8ed; }  /* first blood   */
    .sb-unsolved      { color:#555; }          /* simple “x”    */

    /* tiny red dot for “just solved” */
    .sb-last-dot {
      position:absolute; top:-2px; right:-2px;
      width:.5rem; height:.5rem; border-radius:50%;
      background:#dc2626; border:1px solid #222;
    }
  </style>
{% endblock %}

{% block content %}
<h1 class="title is-3">Scoreboard</h1>

<table class="table is-fullwidth is-bordered">
  <thead>
    <tr>
      <th>#</th>
      <th>username</th>
      <th>score</th>
      <th></th>
    </tr>
  </thead>

  {# initial tbody and the HTMX auto-refresh container #}
  {% include "partials/scoreboard_table.jhtml" %}

</table>
{% endblock %}