{% extends "base.jhtml" %}

{# ──────────── <head> overrides ──────────── #}
{% block title %}{{ task.task_name }} – Task{% endblock %}

{% block content %}

<a class="button is-light mb-4" href="{{ url_for('tasks_page') }}">
  ← Back to tasks
</a>

<div class="card">
  <header class="card-header">
    <p class="card-header-title is-size-4">
      {{ task.task_name }}
    </p>
    <span class="tag is-medium ml-2">{{ task.scoring.points }} pts</span>
  </header>

  <div class="card-content">
    <p class="mb-2">
      <strong>Category:</strong> {{ task.category|capitalize }}
    </p>

    {# Long description – add rich HTML in the DB or markdown-render beforehand #}
    <div class="content">
      {{ task.description_html | safe }}
    </div>

    {% if task.is_solved_by(curr_user) %}
      <article class="message is-success">
        <div class="message-body">
          ✅ You have already solved this challenge. Great job!
        </div>
      </article>
    {% endif %}
  </div>

  {% if task.attachments %} {# WIP #}
  <footer class="card-footer">
    {% for file in task.attachments %}
      <a href="{{ file.url }}" class="card-footer-item">
        📥 {{ file.name }}
      </a>
    {% endfor %}
  </footer>
  {% endif %}
</div>

{% endblock %}
