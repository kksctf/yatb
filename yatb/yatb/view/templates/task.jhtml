{% extends "base.jhtml" %}

{% block title %}
  {{ selected_task.task_name }} – {{ _("Task") }}
{% endblock title %}

{% block content %}
  <div class="container">
    <a class="button mb-4" href="{{ url_for('tasks_page') }}">{{ _("← Back to tasks") }}</a>
    {% with task = selected_task %}
      {% include "partials/task_card.jhtml" %}
    {% endwith %}
  </div>
{% endblock content %}
